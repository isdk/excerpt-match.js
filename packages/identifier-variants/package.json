{
  "name": "@isdk/identifier-variants",
  "version": "0.1.0",
  "description": "Identifier variant normalization: TensorFlow / tensor_flow / tensor-flow → one form",
  "license": "MIT",
  "keywords": [
    "identifier",
    "normalization",
    "camelcase",
    "snake-case",
    "kebab-case",
    "variants",
    "tokenize"
  ],
  "author": "Riceball LEE <snowyu.lee@gmail.com>",
  "homepage": "https://github.com/isdk/excerpt-match.js/tree/main/packages/identifier-variants#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isdk/excerpt-match.js.git",
    "directory": "packages/identifier-variants"
  },
  "bugs": {
    "url": "https://github.com/isdk/excerpt-match.js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "publish": "pnpm run build && pnpm publish",
    "release": "pnpm run clean && pnpm run build && npx commit-and-tag-version -s --tag-prefix \"@isdk/identifier-variants/\"",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  }
}
