{
  "name": "@isdk/approx-text-match",
  "version": "0.1.1",
  "description": "Approximate substring location: find the most similar contiguous span with a similarity score in long text",
  "license": "MIT",
  "keywords": [
    "fuzzy-matching",
    "substring",
    "approximate",
    "levenshtein",
    "bitap",
    "text-search",
    "similarity"
  ],
  "author": "Riceball LEE <snowyu.lee@gmail.com>",
  "homepage": "https://github.com/isdk/excerpt-match.js/tree/main/packages/approx-text-match#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isdk/excerpt-match.js.git",
    "directory": "packages/approx-text-match"
  },
  "bugs": {
    "url": "https://github.com/isdk/excerpt-match.js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "release": "pnpm run clean && pnpm run build && npx commit-and-tag-version -s --tag-prefix \"@isdk/approx-text-match/\"",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "diff-match-patch": ">=1.0.5",
    "diff-match-patch-es": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "diff-match-patch": {
      "optional": true
    },
    "diff-match-patch-es": {
      "optional": true
    }
  },
  "devDependencies": {
    "fast-check": "^4.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  }
}
