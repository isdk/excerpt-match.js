{
  "name": "@isdk/approx-text-match",
  "version": "0.1.0",
  "description": "近似子串定位：在长文本里找出最相似的连续区间 + 相似度（模糊搜索库做不到的事）",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "release": "npx commit-and-tag-version -s --tag-prefix \"@isdk/approx-text-match/\"",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "diff-match-patch": ">=1.0.5",
    "diff-match-patch-es": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "diff-match-patch": {
      "optional": true
    },
    "diff-match-patch-es": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  }
}
