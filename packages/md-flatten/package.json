{
  "name": "@isdk/md-flatten",
  "version": "0.1.0",
  "description": "markdown 源码 ↔ 渲染后文本的双向坐标映射：评论锚定、引用校验、文档 diff",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "release": "npx commit-and-tag-version -s --tag-prefix \"@isdk/md-flatten/\"",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@isdk/normalize-text": "workspace:*",
    "secondary-cache": "^2.1.2"
  },
  "peerDependencies": {
    "mdast-util-from-markdown": ">=2.0.0",
    "mdast-util-gfm": ">=3.0.0",
    "micromark-extension-gfm": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "mdast-util-from-markdown": {
      "optional": true
    },
    "mdast-util-gfm": {
      "optional": true
    },
    "micromark-extension-gfm": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.0.0",
    "micromark-extension-gfm": "^3.0.0"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  }
}
