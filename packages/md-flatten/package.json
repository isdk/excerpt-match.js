{
  "name": "@isdk/md-flatten",
  "version": "0.1.1",
  "description": "Bidirectional coordinate mapping between markdown source and rendered text: comment anchoring, citation checking, document diff",
  "license": "MIT",
  "keywords": [
    "markdown",
    "source-map",
    "coordinates",
    "position-mapping",
    "anchor",
    "comments",
    "diff"
  ],
  "author": "Riceball LEE <snowyu.lee@gmail.com>",
  "homepage": "https://github.com/isdk/excerpt-match.js/tree/main/packages/md-flatten#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isdk/excerpt-match.js.git",
    "directory": "packages/md-flatten"
  },
  "bugs": {
    "url": "https://github.com/isdk/excerpt-match.js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "publish": "pnpm run build && pnpm publish",
    "release": "pnpm run clean && pnpm run build && npx commit-and-tag-version -s --tag-prefix \"@isdk/md-flatten/\"",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@isdk/normalize-text": "workspace:*",
    "secondary-cache": "^2.1.2"
  },
  "peerDependencies": {
    "mdast-util-from-markdown": ">=2.0.0",
    "mdast-util-gfm": ">=3.0.0",
    "micromark-extension-gfm": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "mdast-util-from-markdown": {
      "optional": true
    },
    "mdast-util-gfm": {
      "optional": true
    },
    "micromark-extension-gfm": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.0.0",
    "micromark-extension-gfm": "^3.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  }
}
