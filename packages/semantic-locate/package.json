{
  "name": "@isdk/semantic-locate",
  "version": "0.1.0",
  "description": "Two-stage semantic locating: retrieve candidate segments externally, then align to exact character offsets within a segment",
  "license": "MIT",
  "keywords": [
    "semantic-search",
    "locate",
    "alignment",
    "rerank",
    "candidates",
    "text-position",
    "nlp"
  ],
  "author": "Riceball LEE <snowyu.lee@gmail.com>",
  "homepage": "https://github.com/isdk/excerpt-match.js/tree/main/packages/semantic-locate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isdk/excerpt-match.js.git",
    "directory": "packages/semantic-locate"
  },
  "bugs": {
    "url": "https://github.com/isdk/excerpt-match.js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "publish": "pnpm run build && pnpm publish",
    "release": "pnpm run clean && pnpm run build && npx commit-and-tag-version -s --tag-prefix \"@isdk/semantic-locate/\"",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@isdk/zh-negation": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  }
}
