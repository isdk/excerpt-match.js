{
  "name": "@isdk/excerpt-match",
  "version": "1.0.0",
  "license": "MIT",
  "keywords": [
    "excerpt",
    "quote",
    "citation",
    "markdown",
    "fuzzy-matching",
    "locate",
    "source-mapping",
    "text-search"
  ],
  "author": "Riceball LEE <snowyu.lee@gmail.com>",
  "homepage": "https://github.com/isdk/excerpt-match.js/tree/main/packages/excerpt-match#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isdk/excerpt-match.js.git",
    "directory": "packages/excerpt-match"
  },
  "bugs": {
    "url": "https://github.com/isdk/excerpt-match.js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "publish": "pnpm run build && pnpm publish",
    "release": "npx commit-and-tag-version -s --tag-prefix \"@isdk/excerpt-match/\"",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@isdk/approx-text-match": "workspace:*",
    "@isdk/identifier-variants": "workspace:*",
    "@isdk/md-flatten": "workspace:*",
    "@isdk/nlp-jieba": "^2.2.2",
    "@isdk/normalize-text": "workspace:*",
    "@isdk/semantic-locate": "workspace:*",
    "@isdk/whitespace-semantics": "workspace:*",
    "@isdk/zh-negation": "workspace:*",
    "@isdk/zh-particles": "workspace:*",
    "cjk-number": "^1.0.0",
    "diff-match-patch-es": "^2.0.1",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "secondary-cache": "^2.1.2"
  },
  "peerDependencies": {
    "diff-match-patch": "^1.0.5"
  },
  "peerDependenciesMeta": {
    "diff-match-patch": {
      "optional": true
    }
  },
  "devDependencies": {
    "@isdk/match-ex": "^0.1.2",
    "@types/diff-match-patch": "^1.0.32",
    "@types/node": "^20.11.0",
    "diff-match-patch": "^1.0.5",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "packageManager": "pnpm@12.4.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "description": "Locate an excerpt within a markdown document and return exact source coordinates (index/length)",
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  }
}
