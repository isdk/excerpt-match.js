{
  "name": "@isdk/normalize-text",
  "version": "0.1.0",
  "description": "归一化文本并保留原文坐标映射——搜索高亮、引用定位、文本 diff 都需要",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@isdk/identifier-variants": "workspace:*",
    "@isdk/whitespace-semantics": "workspace:*",
    "@isdk/zh-particles": "workspace:*"
  },
  "peerDependencies": {
    "cjk-number": ">=0.2.0"
  },
  "peerDependenciesMeta": {
    "cjk-number": {
      "optional": true
    }
  },
  "devDependencies": {
    "cjk-number": "^1.0.0",
    "fast-check": "^4.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  }
}
