{
  "name": "@isdk/normalize-text",
  "version": "0.1.0",
  "description": "Normalize text while keeping a coordinate map back to the source — for search highlighting, citation locating, and text diff",
  "license": "MIT",
  "keywords": [
    "normalize",
    "unicode",
    "nfc",
    "index-mapping",
    "coordinates",
    "text-processing",
    "chinese"
  ],
  "author": "Riceball LEE <snowyu.lee@gmail.com>",
  "homepage": "https://github.com/isdk/excerpt-match.js/tree/main/packages/normalize-text#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isdk/excerpt-match.js.git",
    "directory": "packages/normalize-text"
  },
  "bugs": {
    "url": "https://github.com/isdk/excerpt-match.js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "publish": "pnpm run build && pnpm publish",
    "release": "npx commit-and-tag-version -s --tag-prefix \"@isdk/normalize-text/\"",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@isdk/identifier-variants": "workspace:*",
    "@isdk/whitespace-semantics": "workspace:*",
    "@isdk/zh-particles": "workspace:*"
  },
  "peerDependencies": {
    "cjk-number": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "cjk-number": {
      "optional": true
    }
  },
  "devDependencies": {
    "cjk-number": "^1.0.0",
    "fast-check": "^4.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  }
}
